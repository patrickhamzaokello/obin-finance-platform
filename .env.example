# Copy this file to .env.production and fill in real values.
# Never commit .env.production.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_BASE_DOMAIN=your-domain.com   # used by proxy.ts for subdomain routing
BETTER_AUTH_SECRET=1UVqPYbTiWz8yQmL3yg7h0F7+w0G5Ks5tEwcaAfl9j4=
BETTER_AUTH_URL=https://your-domain.com

# ── Database — Neon ───────────────────────────────────────────────────────────
# Paste your Neon connection string (Settings → Connection string → Pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=learningplatform
AWS_CLOUDFRONT_DOMAIN=https://your-cf-domain.cloudfront.net

# ── Vercel Blob (legacy — only needed if old blob URLs still exist) ───────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_alGc7IUwDi7bs4T8_VQGKVQ6mifx5jDbImfrYSAr7JJkrZs

# ── ioTec Pay ────────────────────────────────────────────────────────────────
# Get credentials from: https://pay.iotec.io → your wallet → Settings
# OAuth token endpoint: https://id.iotec.io/connect/token
IOTEC_CLIENT_ID=02608609
IOTEC_CLIENT_SECRET=
IOTEC_WALLET_ID=02608609                   # UUID of your ioTec Pay wallet
IOTEC_CURRENCY=UGX                     # Default currency
IOTEC_WEBHOOK_SECRET=                  # Optional: shared secret for webhook verification

# ── Plunk (transactional email) ──────────────────────────────────────────────
# Get key from: https://app.useplunk.com → Settings → API Keys
PLUNK_SECRET_KEY=
PLUNK_FROM_EMAIL=hello@ObinAcademy.com    # Must be a verified sender domain in Plunk
